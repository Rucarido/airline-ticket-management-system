# ──────────────────────────────────────────────────────────
#  .gitignore — Airline Ticket Reservation System
# ──────────────────────────────────────────────────────────

# ── Environment & Secrets ─────────────────────────────────
.env
.env.*
!.env.example

# ── Local agent/tooling state ─────────────────────────────
.agents/
.omo/
AGENTS.md
mvp_blueprint.md
report-proof/

# ── Node.js ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Build outputs ─────────────────────────────────────────
dist/
build/
.vite/
*.tsbuildinfo

# ── Python (virtual env from .venv) ──────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# ── Logs ─────────────────────────────────────────────────
logs/
*.log

# ── OS-generated files ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor & IDE ─────────────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Local Docker override ─────────────────────────────────
# Keep docker-compose.yml tracked
docker-compose.override.yml

# ── PostgreSQL dumps ──────────────────────────────────────
*.sql.bak
*.dump

# ── Test output ───────────────────────────────────────────
coverage/
.nyc_output/
